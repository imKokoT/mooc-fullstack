
@baseUrl = http://localhost:3001

### GET BLOGS
GET {{baseUrl}}/api/blogs HTTP/1.1

### GET BLOG
# @prompt id
GET {{baseUrl}}/api/blogs/{{id}} HTTP/1.1

### CREATE NEW BLOG
# @prompt title
# @prompt url
# @prompt token
POST {{baseUrl}}/api/blogs HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "title": "{{title}}",
    "url": "{{url}}"
}

### GET ALL USERS
# @prompt token
GET {{baseUrl}}/api/users HTTP/1.1
Authorization: Bearer {{token}}


### GET USER
# @prompt id
# @prompt token
GET {{baseUrl}}/api/users/{{id}} HTTP/1.1
Authorization: Bearer {{token}}


### SIGNUP
# @prompt username
# @prompt password
POST {{baseUrl}}/api/signup HTTP/1.1
Content-Type: application/json

{
    "username": "{{username}}",
    "password": "{{password}}"
}

### LOGIN
# @prompt username
# @prompt password
POST {{baseUrl}}/api/login HTTP/1.1
Content-Type: application/json

{
    "username": "{{username}}",
    "password": "{{password}}"
}
